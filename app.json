{
  "expo": {
    "name": "Selectas",
    "slug": "selectas",
    "version": "0.1.0",
    "scheme": "selectas",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.example.selectas"
    },
    "android": {
      "package": "com.example.selectas"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-notifications"
    ]
  }
}
